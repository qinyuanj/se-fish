# ===== 编辑器运行产物 =====
/log.txt
*.log

# ===== 外部链接 =====
# 兼容旧工作区遗留的外部符号链接（正式设计文档已入库 docs/design/）
/design

# ===== AI 助手 / teamai 分发文件（工具自动下发，可重新生成）=====
# .agents/* 而非 .agents/：agy 通过 .agents/skills.json 登记共享技能目录，
# 该登记文件描述仓内受管内容（.dsh/skills/spoke，见 ADR-0022），必须入库。
/.agents/*
!/.agents/skills.json
/.claude/
/.codemaker/
/.codex/
# .dsh/ 是 DSH 的会话技能目录，工具下发、可重新生成；唯一例外是 spoke——
# 它的库与技能都由上游 spoke 仓库维护，必须同版本（ADR-0022）。
/.dsh/*
!/.dsh/skills/
/.dsh/skills/*
!/.dsh/skills/spoke/
/.kimi-code/
/.teamai/
/.zcode/

# ===== IDE =====
.vscode/*
!.vscode/launch.json
.idea/
*.swp
*~

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Python 缓存与本地虚拟环境 =====
__pycache__/
*.py[co]
/.venv/
/venv/

# ===== 工具链临时 / 缓存目录 =====
/tmp/
/build/
/target/
/.toolcache/
# LuaCov 根产物：覆盖率运行（busted --coverage / crapper）在仓库根产出的统计与报告。
/luacov.stats.out
/luacov.report.out

