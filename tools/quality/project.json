{
  "sources": {"roots": ["client", "common", "server"], "exclude": ["server/_trigger"]},
  "lua": {"executable": "lua5.4", "version": "Lua 5.4.", "pkg_config": "lua5.4"},
  "commands": {
    "coverage": ["busted", "--run=full", "--coverage"],
    "mutation_test": ["busted", "--run=fast"]
